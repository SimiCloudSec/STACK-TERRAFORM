pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: ['apply', 'destroy'],
            description: 'Terraform action to perform'
        )
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'staging', 'prod'],
            description: 'Target environment'
        )
        booleanParam(
            name: 'AUTO_APPROVE',
            defaultValue: false,
            description: 'Skip manual approval?'
        )
    }

    environment {
        AWS_REGION = 'us-east-1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                dir('clixx') {
                    sh 'terraform init -input=false'
                }
                echo "Terraform Init: SUCCESS"
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('clixx') {
                    script {
                        if (params.ACTION == 'destroy') {
                            sh 'terraform plan -destroy -out=tfplan -input=false'
                        } else {
                            sh 'terraform plan -out=tfplan -input=false'
                        }
                    }
                }
                echo "Terraform Plan: COMPLETE - Ready for approval"
            }
        }

        stage('Approval') {
            when {
                expression { params.AUTO_APPROVE == false }
            }
            steps {
                input message: "Proceed with ${params.ACTION}?", ok: "Approve"
            }
        }

        stage('Terraform Apply') {
            steps {
                dir('clixx') {
                    sh 'terraform apply -auto-approve tfplan'
                }
                echo "SUCCESS: CLIXX Infrastructure - ${params.ACTION}"
            }
        }
    }

    post {
        success {
            echo "Pipeline completed successfully!"
        }
        failure {
            echo "PIPELINE FAILED"
        }
    }
}
