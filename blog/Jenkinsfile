pipeline {
    agent any
    parameters {
        choice(name: 'ACTION', choices: ['apply', 'destroy'], description: 'Terraform action')
        booleanParam(name: 'AUTO_APPROVE', defaultValue: false, description: 'Skip approval')
    }
    stages {
        stage('Checkout') {
            steps {
                slackSend(color: '#FFFF00', message: ":rocket: STARTING BLOG DEPLOYMENT: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]'")
                checkout scm
            }
        }
        stage('Terraform Init') {
            steps {
                dir('blog') { sh 'terraform init -input=false' }
            }
        }
        stage('Terraform Plan') {
            steps {
                dir('blog') {
                    script {
                        if (params.ACTION == 'destroy') { sh 'terraform plan -destroy -out=tfplan -input=false' }
                        else { sh 'terraform plan -out=tfplan -input=false' }
                    }
                }
            }
        }
        stage('Approval') {
            when { expression { return !params.AUTO_APPROVE } }
            steps { input message: "Proceed with ${params.ACTION}?", ok: "Approve" }
        }
        stage('Terraform Apply') {
            steps {
                dir('blog') { sh 'terraform apply -auto-approve tfplan' }
            }
        }
    }
    post {
        success { slackSend(color: '#00FF00', message: ":white_check_mark: BLOG SUCCESS: http://dev.blog.stack-simi.com") }
        failure { slackSend(color: '#FF0000', message: ":x: BLOG FAILED") }
    }
}
